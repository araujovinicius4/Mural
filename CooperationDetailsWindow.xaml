<Window x:Class="MuralInstitucional.CooperationDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Detalhes e cooperação local" Width="650" Height="760" MinWidth="380" MinHeight="480"
 WindowStartupLocation="CenterOwner" Background="#EFF3F8">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
  <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
  <TextBlock Text="Simulação local: os dois papéis são operados neste perfil, sem autenticação ou envio. Não há anonimato seguro entre usuários reais." TextWrapping="Wrap" Margin="0,10"/>
  <TextBlock Text="{Binding Distribution.Summary}" TextWrapping="Wrap" FontWeight="SemiBold"/>
  <TextBlock Text="Distribuição indica critérios locais; não envia a outros computadores." TextWrapping="Wrap" Margin="0,4,0,12"/>
  <TextBlock Text="O aceite refere-se à solicitação de cooperação, nunca à autorização para publicar o anúncio. Não autoriza desvio de função ou descumprimento de obrigações institucionais." TextWrapping="Wrap" Foreground="#193456"/>
  <StackPanel x:Name="FlowPanel" Margin="0,12,0,0">
   <TextBlock Text="Solicitações locais (identificadores técnicos, sem prioridade por identidade)" TextWrapping="Wrap"/>
   <ComboBox x:Name="RequestInput" DisplayMemberPath="Id" SelectionChanged="Request_Changed" Margin="0,6"/>
   <TextBlock x:Name="StateText" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Text="Análise objetiva: compatibilidade com a necessidade/oferta, habilidades e disponibilidade. Sem prioridade por amizade, hierarquia ou identidade." TextWrapping="Wrap" Margin="0,10"/>
   <TextBlock Text="Justificativa objetiva opcional (até 500 caracteres; não inclua dados pessoais)" TextWrapping="Wrap"/>
   <TextBox x:Name="ReasonInput" MaxLength="500" Height="65" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,6"/>
   <TextBlock Text="Ações do solicitante / responsável — simulação no mesmo perfil" TextWrapping="Wrap"/>
   <WrapPanel x:Name="ActionsPanel" Margin="0,6"/>
   <TextBlock x:Name="IdentityText" TextWrapping="Wrap" Margin="0,10"/>
   <CheckBox x:Name="RequesterCheck" Content="Simular consentimento explícito do solicitante para identificação" Margin="0,5"/>
   <Button x:Name="RequesterConsentButton" Content="Registrar consentimento do solicitante" Click="RequesterConsent_Click" HorizontalAlignment="Left" Padding="10,7"/>
   <CheckBox x:Name="ResponsibleCheck" Content="Simular consentimento explícito do responsável para identificação" Margin="0,5"/>
   <Button x:Name="ResponsibleConsentButton" Content="Registrar consentimento do responsável" Click="ResponsibleConsent_Click" HorizontalAlignment="Left" Padding="10,7"/>
   <TextBlock Text="Histórico local (não é auditoria autenticada)" FontWeight="SemiBold" Margin="0,12,0,4"/>
   <TextBlock x:Name="HistoryText" TextWrapping="Wrap"/>
  </StackPanel>
  <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Margin="0,12"/>
  <Button Content="Fechar" IsCancel="True" HorizontalAlignment="Right" Padding="16,8"/>
 </StackPanel></ScrollViewer>
</Window>
