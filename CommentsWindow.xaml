<Window x:Class="MuralInstitucional.CommentsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Comentários locais" Width="520" Height="560" MinWidth="320" MinHeight="360" WindowStartupLocation="CenterOwner" Background="#EFF3F8">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Text="Interação neste perfil local • evite dados pessoais ou informações sensíveis." TextWrapping="Wrap" Margin="0,8,0,14"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ItemsControl ItemsSource="{Binding Comments}"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,10"><StackPanel>
     <TextBlock Text="Perfil local (sem autenticação)" FontWeight="SemiBold" Foreground="#416D9B"/>
     <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,6,0,6"/>
     <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" FontSize="11" Foreground="#65758C"/>
    </StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,12,0,0">
   <TextBlock Text="Novo comentário (até 1.000 caracteres)"/>
   <TextBox x:Name="CommentInput" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" Height="72" VerticalScrollBarVisibility="Auto" Margin="0,6,0,8" AutomationProperties.Name="Novo comentário"/>
   <TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="#A13838"/>
   <WrapPanel><Button Content="Adicionar comentário" Click="Add_Click" Padding="12,8" Margin="0,6,8,0"/><Button Content="Fechar" Click="Close_Click" Padding="12,8" Margin="0,6,0,0"/></WrapPanel>
  </StackPanel>
 </Grid>
</Window>
