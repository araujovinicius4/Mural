<Window x:Class="MuralInstitucional.AnnouncementEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:MuralInstitucional.Controls"
 Title="Anúncio local" Width="580" Height="720" MinWidth="360" MinHeight="480" WindowStartupLocation="CenterOwner" Background="#EFF3F8">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <TextBlock x:Name="Heading" Text="Novo anúncio" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="Cadastro neste perfil. Sem publicação multiusuário ou autenticação." TextWrapping="Wrap" Margin="0,6,0,16"/>
   <TextBlock Text="Título * (até 200 caracteres)"/><TextBox x:Name="TitleInput" MaxLength="200" Margin="0,5,0,12" Padding="8"/>
   <TextBlock Text="Descrição (opcional, até 2.000 caracteres)"/><TextBox x:Name="DescriptionInput" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto" Margin="0,5,0,12"/>
   <TextBlock Text="Tipo de mídia"/><ComboBox x:Name="KindInput" SelectedIndex="0" SelectionChanged="Kind_Changed" Margin="0,5,0,10"><ComboBoxItem Content="Imagem"/><ComboBoxItem Content="Vídeo"/></ComboBox>
   <Button Content="Selecionar arquivo local…" Click="Select_Click" Padding="10,7" HorizontalAlignment="Left"/>
   <TextBlock x:Name="FileLabel" Text="Nenhum arquivo selecionado" TextWrapping="Wrap" Margin="0,8,0,10"/>
   <Border CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,12"><controls:SquareMediaPanel Width="180">
    <controls:CoverImage x:Name="Preview"/>
    <TextBlock x:Name="PreviewNotice" Text="Prévia de imagem • vídeo sem reprodução no editor" TextWrapping="Wrap" Margin="16" VerticalAlignment="Center" TextAlignment="Center"/>
   </controls:SquareMediaPanel></Border>
   <TextBlock Text="URL HTTP/HTTPS (opcional)"/><TextBox x:Name="UrlInput" MaxLength="2048" Margin="0,5,0,10" Padding="8"/>
   <TextBlock Text="PNG/JPG/JPEG até 20 MB; AVI/MP4/WMV até 250 MB. Mídia copiada para a pasta do aplicativo ao salvar." TextWrapping="Wrap" FontSize="12"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#A13838"/>
   <WrapPanel Margin="0,8,0,0"><Button Content="Salvar" Click="Save_Click" Padding="16,8" Margin="0,0,10,0"/><Button Content="Cancelar" IsCancel="True" Padding="16,8"/></WrapPanel>
  </StackPanel>
 </Grid>
</Window>
