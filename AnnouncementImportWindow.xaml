<Window x:Class="MuralInstitucional.AnnouncementImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:MuralInstitucional.Controls"
 Title="Importar anúncio (ZIP)" Width="580" Height="700" MinWidth="360" MinHeight="480" Background="#EFF3F8" WindowStartupLocation="CenterOwner">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <TextBlock Text="Prévia do anúncio recebido" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Text="Origem não autenticada. A confirmação cria um novo cadastro somente neste computador." TextWrapping="Wrap" Margin="0,8,0,16"/>
   <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding TypeLabel}" Margin="0,8"/>
   <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding PublishedAt, StringFormat='Publicação original: {0:dd/MM/yyyy HH:mm}'}" Margin="0,10"/>
   <TextBlock Text="{Binding Distribution.Summary}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding ExternalUrl}" TextWrapping="Wrap" Margin="0,10"/>
   <controls:SquareMediaPanel Width="220" HorizontalAlignment="Left"><controls:CoverImage x:Name="PreviewImage"/>
    <MediaElement x:Name="PreviewVideo" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" MediaFailed="Video_Failed"/>
   </controls:SquareMediaPanel>
   <TextBlock x:Name="MediaNotice" TextWrapping="Wrap" Margin="0,8"/>
   <Button x:Name="PlayVideo" Content="Reproduzir prévia do vídeo" Click="Play_Click" HorizontalAlignment="Left" Padding="10,7"/>
   <TextBlock x:Name="DuplicateNotice" Foreground="#924820" TextWrapping="Wrap" Margin="0,12"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock x:Name="ErrorText" Foreground="#A13838" TextWrapping="Wrap"/>
   <WrapPanel Margin="0,8,0,0"><Button x:Name="ConfirmButton" Content="Confirmar importação" Click="Confirm_Click" Padding="14,8" Margin="0,0,10,0"/>
    <Button Content="Cancelar" IsCancel="True" Padding="14,8"/></WrapPanel>
  </StackPanel>
 </Grid>
</Window>
